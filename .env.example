# Environment Configuration
NODE_ENV=production

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_INTERVAL=60000

# AI Analysis — Groq (production, free tier)
# Get your free API key at: https://console.groq.com
# Free tier: 14,400 requests/day, ~1s response time
# Model used: llama-3.1-8b-instant
GROQ_API_KEY=

# AI Analysis — Ollama (local development only)
# Install: https://ollama.com | Run: ollama pull qwen2.5:7b
# Only used when NODE_ENV != production and GROQ_API_KEY is not set
OLLAMA_MODEL=qwen2.5:7b
